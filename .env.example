# taskctl Environment Variables
# Copy this file to .env (Vercel dashboard or local) and fill in the values.
# NEVER commit real secrets to Git — add .env to .gitignore.

# ── Neon Postgres ─────────────────────────────────────────────────────────────
# Your Neon connection string (from console.neon.tech → Connect → Node.js)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# ── Optional: password-protect the web API ────────────────────────────────────
# If set, the website and Telegram bot must send this in the X-Todo-Password header.
# Also used by /api/keys and /api/task to authenticate requests.
TODO_PASSWORD=

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Get your token from @BotFather on Telegram after creating a bot.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: a random secret string for webhook security.
# Pass it when registering the webhook:
#   POST https://api.telegram.org/bot<TOKEN>/setWebhook
#        ?url=https://<your-domain>/api/telegram
#        &secret_token=<this-value>
# Telegram will include it in X-Telegram-Bot-Api-Secret-Token on every request.
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_random_string

# ── Vercel Cron security ───────────────────────────────────────────────────────
# Vercel sends this as  Authorization: Bearer <value>  to /api/reminders.
# Set it in the Vercel dashboard and here so local testing works too.
CRON_SECRET=change_me_to_a_random_string

# ── API Endpoints reference (no config needed — auto-discovered from DATABASE_URL) ──
#
# GET  /api/health           → public health check (no auth)
# GET  /api/stats            → task analytics summary (requires X-Todo-Password)
# GET  /api/tasks            → fetch full task list
# PUT  /api/tasks            → replace full task list
# GET  /api/task?id=<id>     → fetch a single task
# PATCH /api/task?id=<id>    → update fields of a single task
# DELETE /api/task?id=<id>   → delete a single task
# GET  /api/keys             → list API keys (names + prefix only)
# POST /api/keys             → create a new API key (returns plaintext once)
# DELETE /api/keys?id=<id>   → revoke an API key
# POST /api/telegram         → Telegram bot webhook (registered via @BotFather)
# GET  /api/reminders        → trigger daily reminder cron (requires Authorization: Bearer <CRON_SECRET>)
